# Groq Cloud API Key (Optional)
# If provided, powers ultra-fast Llama-3.3-70b / Mixtral AI features.
# If omitted, the app will seamlessly use the smart built-in offline enhancer.
GROQ_API_KEY=

# Sanity CMS GROQ Integration (Optional)
# If omitted, the app will automatically use the built-in local templates.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Public Site URL for SEO / Sitemap (Optional)
NEXT_PUBLIC_SITE_URL=
